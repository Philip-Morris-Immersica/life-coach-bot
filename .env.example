# --- Telegram ---
# Вземи от @BotFather в Telegram: /newbot -> копирай токена тук
TELEGRAM_BOT_TOKEN=

# --- OpenAI ---
# Твоят OpenAI API ключ (вече го имаш)
OPENAI_API_KEY=
# Евтин/бърз модел за кратки check-in-и
OPENAI_MODEL_FAST=gpt-4o-mini
# По-силен модел за дълбоки коучинг сесии
OPENAI_MODEL_DEEP=gpt-4o

# --- Neon (Postgres) ---
# Connection string от нов Neon проект (отделен от Compass-Centre).
# Neon Dashboard -> Project -> Connection string (с ?sslmode=require)
DATABASE_URL=

# --- Разписание на проактивните check-in-и (часова зона на сървъра) ---
# Тези стойности са fallback; админ панелът ги override-ва.
MORNING_HOUR=8
MORNING_MINUTE=0
EVENING_HOUR=21
EVENING_MINUTE=0
TIMEZONE=Europe/Sofia

# --- Уеб приложение (Next.js) ---
# Тайна за подписване на JWT сесионни бисквитки. Генерирай с:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Имейли, които автоматично стават админи при регистрация (списък през запетая).
ADMIN_EMAILS=
