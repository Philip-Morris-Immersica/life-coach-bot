# ===================== Задължителни за сайта (Vercel) =====================

# --- Neon (Postgres) ---
DATABASE_URL=

# --- LLM ---
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o
# Дълбоките сесии по подразбиране ползват Claude.
ANTHROPIC_API_KEY=

# --- Уеб ---
# Публичен URL на сайта (https://... във Vercel). QStash вика този адрес.
WEB_URL=http://localhost:3000
# Таен ключ за сесийните cookies (>=32 символа).
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Имейли (comma-separated), които стават админи при регистрация.
ADMIN_EMAILS=

# ===================== Достъп и контрол на разходите =====================

# Invite-only режим. Ако е попълнено, регистрацията изисква един от тези кодове
# (comma-separated). Празно = отворена регистрация (не се препоръчва публично).
INVITE_CODES=
# Максимум потребителски съобщения към коуча на ден на човек.
DAILY_MESSAGE_LIMIT=60

# ===================== Web Push напомняния =====================

# VAPID ключове: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контакт за push услугите (mailto: или https:)
VAPID_SUBJECT=mailto:you@example.com

# QStash (https://console.upstash.com/qstash) — планира всяко напомняне
# отделно, без постоянен процес и без проверка на базата всяка минута.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Само ако ползваш EU/друг регион на QStash:
# QSTASH_URL=https://qstash-eu-central-1.upstash.io

# ===================== Telegram (по избор, НЕ във Vercel) =====================
# Ботът е отделен процес: npm run bot (локално или на един малък сървър).
# Във Vercel тези променливи не са нужни.
TELEGRAM_BOT_TOKEN=
# Позволени Telegram ID-та (comma-separated). Празно = всеки може да пише на бота.
TELEGRAM_ALLOWED_IDS=
# "off" = ботът не праща напомняния и не проверява базата всяка минута (напомнянията са в сайта).
TELEGRAM_SCHEDULER=on

# --- Глобални дефолти (персоналните напомняния се пазят в базата) ---
TIMEZONE=Europe/Sofia
