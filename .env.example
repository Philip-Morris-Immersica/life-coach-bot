# --- Telegram ---
# Вземи от @BotFather: /newbot -> копирай токена тук
TELEGRAM_BOT_TOKEN=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_DEEP=gpt-4o

# --- Anthropic (Claude) ---
# Дълбоките сесии по подразбиране ползват Claude 3.5 Sonnet.
ANTHROPIC_API_KEY=

# --- Neon (Postgres) ---
DATABASE_URL=

# --- Уеб ---
# Базов публичен URL на уеб приложението (за линкове към сесии в Telegram).
WEB_URL=http://localhost:3000
# Таен ключ за сесийните cookies (>=16 символа).
SESSION_SECRET=
# Имейли (comma-separated), които стават админи при регистрация.
ADMIN_EMAILS=

# --- Глобални дефолти за напомняния (персоналните се пазят в базата) ---
MORNING_HOUR=8
MORNING_MINUTE=0
EVENING_HOUR=21
EVENING_MINUTE=0
TIMEZONE=Europe/Sofia
