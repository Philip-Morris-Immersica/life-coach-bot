# --- Telegram ---
# Вземи от @BotFather в Telegram: /newbot -> копирай токена тук
TELEGRAM_BOT_TOKEN=

# --- OpenAI ---
# Твоят OpenAI API ключ (вече го имаш)
OPENAI_API_KEY=
# Евтин/бърз модел за кратки check-in-и
OPENAI_MODEL_FAST=gpt-4o-mini
# По-силен модел за дълбоки коучинг сесии
OPENAI_MODEL_DEEP=gpt-4o

# --- Neon (Postgres) ---
# Connection string от нов Neon проект (отделен от Compass-Centre).
# Neon Dashboard -> Project -> Connection string (с ?sslmode=require)
DATABASE_URL=

# --- Разписание на проактивните check-in-и (часова зона на сървъра) ---
# Час и минута за сутрешен фокус
MORNING_HOUR=8
MORNING_MINUTE=0
# Час и минута за вечерна рефлексия
EVENING_HOUR=21
EVENING_MINUTE=0
# Часова зона за cron (напр. Europe/Sofia)
TIMEZONE=Europe/Sofia
